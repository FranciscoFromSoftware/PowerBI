        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#1F2D44" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#1F2D44" } },
            "backColorSecondary": { "solid": { "color": "#F4F8FC" } },
            "outline": "Frame",
            "urlIcon": true,
